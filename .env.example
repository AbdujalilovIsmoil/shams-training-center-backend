PORT=4000

# Vergul bilan ajratilgan ruxsat etilgan originlar (admin panel va sayt manzillari)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Profilda admin o'zi kiritgan parolni ko'rishi uchun qaytarib ochiladigan
# shifrlashda ishlatiladigan kalit. Bo'sh qoldirilsa JWT_SECRET ishlatiladi,
# lekin ishlab chiqarishda alohida uzun tasodifiy qiymat qo'yish tavsiya etiladi.
CREDENTIALS_ENC_KEY=change_this_to_another_long_random_secret

# PostgreSQL ulanish manzili
DATABASE_URL=postgresql://localhost:5432/shams_blog

# Faqat "npm run migrate" ishga tushganda admin foydalanuvchini shu login/parol
# bilan bazaga yozadi (agar mavjud bo'lmasa/o'zgartirilmoqchi bo'lsa)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Saytdagi AI-chatbot uchun OpenAI API key (platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
